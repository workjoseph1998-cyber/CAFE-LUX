# EXAMPLE ONLY. Set in the service/WSGI environment; application does not load this file.
CAFE_LUX_DATA_DIR=/absolute/path/outside/source/CafeLuxData
CAFE_LUX_ALLOWED_HOSTS=your-domain.example
# HTTPS production defaults: leave these unset unless your deployment requires them.
# CAFE_LUX_TRUST_PROXY=1
# CAFE_LUX_INSECURE_LOCAL=1  # Local HTTP development only.

# disabled (default), mock (NO SENDS), or live.
CAFE_LUX_WHATSAPP_MODE=disabled
# Get a currently supported Graph version from Meta and set it explicitly (vXX.X).
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
