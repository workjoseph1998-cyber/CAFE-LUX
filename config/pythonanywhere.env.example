# Bash configuration for management commands. The Web tab's WSGI file must set
# these separately; Bash exports are not inherited by the hosted WSGI process.
export CAFE_LUX_DATA_DIR=/home/YOUR_USERNAME/cafe-lux-data
export CAFE_LUX_ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com
export CAFE_LUX_INSECURE_LOCAL=0
export CAFE_LUX_TRUST_PROXY=1
